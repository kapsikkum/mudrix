        "$value": ["Roboto", "sans-serif"]
      },
      "mono": {
        "$value": ["JetBrains Mono", "SF Mono", "Menlo", "Consolas", "monospace"]
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "11px"
      },
      "sm": {
        "$value": "13px"
      },
      "md": {
        "$value": "15px"
      },
      "lg": {
        "$value": "17px"
      },
      "xl": {
        "$value": "20px"
      },
      "xxl": {
        "$value": "24px"
      },
      "display": {
        "$value": "32px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "normal": {
        "$value": 1.45
      },
      "relaxed": {
        "$value": 1.6
      }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": 0.45
    },
    "muted": {
      "$value": 0.7
    },
    "overlay": {
      "$value": 0.6
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "0ms"
      },
      "fast": {
        "$value": "100ms"
      },
      "normal": {
        "$value": "200ms"
      },
      "slow": {
        "$value": "300ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1]
      },
      "decelerate": {
        "$value": [0, 0, 0, 1]
      },
      "accelerate": {
        "$value": [0.3, 0, 1, 1]
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "#00000040",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0px"
      }
    },
    "md": {
      "$value": {
        "color": "#00000059",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0px"
      }
    },
    "lg": {
      "$value": {
        "color": "#00000073",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0px"
      }
    }
  },
  "zIndex": {
    "$type": "number",
    "base": {
      "$value": 0
    },
    "sticky": {
      "$value": 100
    },
    "dropdown": {
      "$value": 1000
    },
    "overlay": {
      "$value": 2000
    },
    "modal": {
      "$value": 3000
    },
    "popover": {
