{
  "$description": "Umbra (from the original WizardChat themes)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "umbra",
      "name": "Umbra",
      "scheme": "dark",
      "order": 4
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#0b0b0d",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#111114",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#1a1a1f",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#0e0e11"
      },
      "hover": {
        "$value": "rgba(255, 255, 255, 0.045)"
      },
      "active": {
        "$value": "rgba(88, 101, 242, 0.2)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#e3e3e8"
      },
      "secondary": {
        "$value": "#686875"
      },
      "muted": {
        "$value": "#8b8b98"
      },
      "disabled": {
        "$value": "#686875"
      },
      "onAccent": {
        "$value": "#ffffff"
      },
      "link": {
        "$value": "#4EA8FF"
      }
    },
    "accent": {
      "default": {
        "$value": "#5865f2"
      },
      "hover": {
        "$value": "#4752c4"
      },
      "soft": {
        "$value": "rgba(88, 101, 242, 0.2)",
        "$description": "Tinted backgrounds, selected rows"
      },
      "glow1": {
        "$value": "rgba(88, 101, 242, 0.06)",
        "$description": "Background glow behind the app"
      },
      "glow2": {
        "$value": "rgba(88, 101, 242, 0.04)"
      }
    },
    "border": {
      "default": {
        "$value": "#222228"
      },
      "strong": {
        "$value": "#222228"
      },
      "focus": {
        "$value": "#5865f2"
      }
    },
    "status": {
      "danger": {
        "$value": "#c93b3b"
      },
      "error": {
        "$value": "#ff6b6b"
      },
      "success": {
        "$value": "#3ba55d"
      },
      "warning": {
        "$value": "#ff9d00"
      },
      "info": {
        "$value": "#4EA8FF"
      },
      "mention": {
        "$value": "#f06428"
      }
    },
    "presence": {
      "online": {
        "$value": "#4ade80"
      },
      "away": {
        "$value": "#facc15"
      },
      "busy": {
        "$value": "#ef4444"
      },
      "offline": {
        "$value": "#6b7280"
      }
    },
    "role": {
      "founder": {
        "$value": "#a855f7"
      },
      "admin": {
        "$value": "#ef4444"
      },
      "moderator": {
        "$value": "#eab308"
      },
      "member": {
        "$value": "#3b82f6"
      }
    },
    "logo": {
      "p0": {
        "$value": "#4752C4"
      },
      "p1": {
        "$value": "#5865F2"
      },
      "p2": {
        "$value": "#4752C4"
      },
      "p3": {
        "$value": "#5865F2"
      },
      "p4": {
        "$value": "#363E99"
      },
      "p5": {
        "$value": "#7983F5"
      },
      "hover": {
        "$value": "#9AA2F8"
      },
      "hoverGlow": {
        "$value": "#9AA2F899"
      }
    },
    "message": {
      "mine": {
        "$value": "#2c3280"
      },
      "other": {
        "$value": "#1a1a1f"
      },
      "highlight": {
        "$value": "#f0642826",
        "$description": "Messages that mention you"
      }
    },
    "username": {
      "c1": {
        "$value": "#4ea8ff"
      },
      "c2": {
        "$value": "#d66bd1"
      },
      "c3": {
        "$value": "#2bd4a0"
      },
      "c4": {
        "$value": "#ff6b92"
      },
      "c5": {
        "$value": "#ff9a4d"
      },
      "c6": {
        "$value": "#3fd3d6"
      },
      "c7": {
        "$value": "#8c87ff"
      },
      "c8": {
        "$value": "#8fdb4a"
      }
    }
  }
}
