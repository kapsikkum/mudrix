{
  "$description": "Cloud (from Mudrix)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "cloud",
      "name": "Cloud",
      "scheme": "light",
      "order": 24
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#f5f8fc",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#e8eef6",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#d8e2ef",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#dfe4ec"
      },
      "hover": {
        "$value": "rgba(6, 6, 7, 0.05)"
      },
      "active": {
        "$value": "rgba(47, 111, 219, 0.14)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#1f2d3f"
      },
      "secondary": {
        "$value": "#919eaf"
