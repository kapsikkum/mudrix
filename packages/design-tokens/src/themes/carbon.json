{
  "$description": "Carbon (from the original WizardChat themes)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "carbon",
      "name": "Carbon",
      "scheme": "dark",
      "default": true,
      "order": 1
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#11111e",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#1c1c30",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#252540",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#1a1a2e"
      },
      "hover": {
        "$value": "#ffffff0d"
      },
      "active": {
        "$value": "#5865f233"
      },
      "overlay": {
        "$value": "#000000a6",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#e8e8f0"
      },
      "secondary": {
        "$value": "#bbbbcc"
