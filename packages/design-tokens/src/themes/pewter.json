{
  "$description": "Pewter (from the original WizardChat themes)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "pewter",
      "name": "Pewter",
      "scheme": "dark",
      "order": 3
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#1e1f22",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#2b2d31",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#383a40",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#232428"
      },
      "hover": {
        "$value": "rgba(255, 255, 255, 0.04)"
      },
      "active": {
        "$value": "rgba(88, 101, 242, 0.2)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#dbdee1"
      },
      "secondary": {
        "$value": "#80848e"
      },
      "muted": {
        "$value": "#949ba4"
      },
      "disabled": {
        "$value": "#80848e"
      },
      "onAccent": {
        "$value": "#ffffff"
      },
      "link": {
        "$value": "#4EA8FF"
      }
    },
    "accent": {
      "default": {
        "$value": "#5865f2"
      },
      "hover": {
        "$value": "#4752c4"
      },
      "soft": {
        "$value": "rgba(88, 101, 242, 0.2)",
        "$description": "Tinted backgrounds, selected rows"
      },
      "glow1": {
        "$value": "rgba(88, 101, 242, 0.06)",
        "$description": "Background glow behind the app"
      },
      "glow2": {
        "$value": "rgba(88, 101, 242, 0.04)"
      }
    },
    "border": {
      "default": {
        "$value": "#3f4147"
      },
      "strong": {
        "$value": "#3f4147"
      },
      "focus": {
        "$value": "#5865f2"
      }
    },
    "status": {
      "danger": {
        "$value": "#da373c"
      },
      "error": {
        "$value": "#ff6b6b"
      },
      "success": {
        "$value": "#23a55a"
      },
      "warning": {
        "$value": "#f0b232"
      },
      "info": {
        "$value": "#4EA8FF"
      },
      "mention": {
        "$value": "#f06428"
      }
    },
    "presence": {
      "online": {
        "$value": "#4ade80"
      },
      "away": {
        "$value": "#facc15"
      },
      "busy": {
        "$value": "#ef4444"
      },
      "offline": {
        "$value": "#6b7280"
      }
    },
    "logo": {
      "p0": {
        "$value": "#4E5157"
      },
      "p1": {
        "$value": "#5D6068"
      },
      "p2": {
        "$value": "#6D7178"
      },
      "p3": {
        "$value": "#8E9297"
      },
      "p4": {
        "$value": "#A2A7AD"
      },
      "p5": {
        "$value": "#B5BAC1"
      },
      "hover": {
        "$value": "#CDD1D7"
      },
      "hoverGlow": {
        "$value": "#CDD1D799"
      }
    },
    "message": {
      "mine": {
        "$value": "#3c45a5"
      },
      "other": {
        "$value": "#383a40"
      },
      "highlight": {
        "$value": "#f0642826",
        "$description": "Messages that mention you"
      }
    },
    "username": {
      "c1": {
        "$value": "#4ea8ff"
      },
      "c2": {
        "$value": "#d66bd1"
      },
      "c3": {
        "$value": "#2bd4a0"
      },
      "c4": {
        "$value": "#ff6b92"
      },
      "c5": {
        "$value": "#ff9a4d"
      },
      "c6": {
        "$value": "#3fd3d6"
      },
      "c7": {
        "$value": "#8c87ff"
      },
      "c8": {
        "$value": "#8fdb4a"
      }
    }
  }
}
