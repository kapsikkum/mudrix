{
  "$description": "Nord (from Mudrix)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "nord",
      "name": "Nord",
      "scheme": "dark",
      "order": 8
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#2e3440",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#272c36",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#3b4252",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#191d23"
      },
      "hover": {
        "$value": "rgba(255, 255, 255, 0.06)"
      },
      "active": {
        "$value": "rgba(136, 192, 208, 0.2)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#eceff4"
      },
      "secondary": {
        "$value": "#7a8393"
      },
      "muted": {
        "$value": "#a3adbf"
      },
      "disabled": {
        "$value": "#7a8393"
