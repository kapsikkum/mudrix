      },
      "glow2": {
        "$value": "rgba(136, 192, 208, 0.03)"
      }
    },
    "border": {
      "default": {
        "$value": "#434c5e"
      },
      "strong": {
        "$value": "#434c5e"
      },
      "focus": {
        "$value": "#88c0d0"
      }
