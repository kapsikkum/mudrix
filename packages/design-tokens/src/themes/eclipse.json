{
  "$description": "Eclipse (from the original WizardChat themes)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "eclipse",
      "name": "Eclipse",
      "scheme": "dark",
      "order": 5
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#000000",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#050507",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#121216",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#08080a"
      },
      "hover": {
        "$value": "rgba(255, 255, 255, 0.05)"
      },
      "active": {
        "$value": "rgba(139, 92, 246, 0.2)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#ececf1"
      },
      "secondary": {
        "$value": "#62626d"
      },
      "muted": {
        "$value": "#8a8a96"
      },
      "disabled": {
        "$value": "#62626d"
      },
      "onAccent": {
        "$value": "#ffffff"
      },
      "link": {
        "$value": "#4EA8FF"
      }
    },
    "accent": {
      "default": {
        "$value": "#8b5cf6"
      },
      "hover": {
        "$value": "#7c4dea"
      },
      "soft": {
        "$value": "rgba(139, 92, 246, 0.2)",
        "$description": "Tinted backgrounds, selected rows"
      },
      "glow1": {
        "$value": "rgba(139, 92, 246, 0.06)",
        "$description": "Background glow behind the app"
      },
      "glow2": {
        "$value": "rgba(139, 92, 246, 0.03)"
      }
    },
    "border": {
      "default": {
        "$value": "#1c1c22"
      },
      "strong": {
        "$value": "#1c1c22"
      },
      "focus": {
        "$value": "#8b5cf6"
      }
    },
    "status": {
      "danger": {
        "$value": "#c93b3b"
      },
      "error": {
        "$value": "#ff6b6b"
      },
      "success": {
        "$value": "#3ba55d"
      },
      "warning": {
        "$value": "#ff9d00"
      },
      "info": {
        "$value": "#4EA8FF"
      },
      "mention": {
        "$value": "#f06428"
      }
    },
    "presence": {
      "online": {
        "$value": "#4ade80"
      },
      "away": {
        "$value": "#facc15"
      },
      "busy": {
        "$value": "#ef4444"
      },
      "offline": {
        "$value": "#6b7280"
      }
    },
    "role": {
      "founder": {
        "$value": "#a855f7"
      },
      "admin": {
        "$value": "#ef4444"
      },
      "moderator": {
        "$value": "#eab308"
      },
      "member": {
        "$value": "#3b82f6"
      }
    },
    "logo": {
      "p0": {
        "$value": "#6D3FD6"
      },
      "p1": {
        "$value": "#8B5CF6"
      },
      "p2": {
        "$value": "#6D3FD6"
      },
      "p3": {
        "$value": "#8B5CF6"
      },
      "p4": {
        "$value": "#4C2A9E"
      },
      "p5": {
        "$value": "#A78BFA"
      },
      "hover": {
        "$value": "#C4B1FC"
      },
      "hoverGlow": {
        "$value": "#C4B1FC99"
      }
    },
    "message": {
      "mine": {
        "$value": "#3b2475"
      },
      "other": {
        "$value": "#121216"
      },
      "highlight": {
        "$value": "#f0642826",
        "$description": "Messages that mention you"
      }
    },
    "username": {
      "c1": {
        "$value": "#4ea8ff"
      },
      "c2": {
        "$value": "#d66bd1"
      },
      "c3": {
        "$value": "#2bd4a0"
      },
      "c4": {
        "$value": "#ff6b92"
      },
      "c5": {
        "$value": "#ff9a4d"
      },
      "c6": {
        "$value": "#3fd3d6"
      },
      "c7": {
        "$value": "#8c87ff"
      },
      "c8": {
        "$value": "#8fdb4a"
      }
    }
  }
}
