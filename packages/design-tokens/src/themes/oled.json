      },
      "glow1": {
        "$value": "#6d7cff0d",
        "$description": "Background glow behind the app"
      },
      "glow2": {
        "$value": "#6d7cff08"
      }
    },
    "border": {
      "default": {
        "$value": "#1a1a1a"
      },
      "strong": {
        "$value": "#363636"
      },
      "focus": {
        "$value": "#a0aaff"
      }
    },
    "status": {
      "danger": {
        "$value": "#c93b3b"
      },
      "error": {
        "$value": "#ff6b6b"
      },
      "success": {
        "$value": "#3ba55d"
      },
      "warning": {
        "$value": "#ff9d00"
      },
      "info": {
        "$value": "#58a6ff"
      },
      "mention": {
        "$value": "#f06428"
      }
    },
    "presence": {
      "online": {
        "$value": "#4ade80"
