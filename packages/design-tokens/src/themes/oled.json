      "c4": {
        "$value": "#ff6b92"
      },
      "c5": {
        "$value": "#ff9a4d"
      },
      "c6": {
        "$value": "#3fd3d6"
      },
      "c7": {
        "$value": "#8c87ff"
      },
      "c8": {
        "$value": "#8fdb4a"
      }
    }
