      "away": {
        "$value": "#facc15"
      },
      "busy": {
        "$value": "#ef4444"
      },
      "offline": {
        "$value": "#6b7280"
      }
    },
    "logo": {
      "p0": {
        "$value": "#6a329f"
      },
      "p1": {
        "$value": "#784cc8"
      },
      "p2": {
        "$value": "#6a329f"
      },
      "p3": {
        "$value": "#784cc8"
      },
      "p4": {
        "$value": "#5e3079"
      },
      "p5": {
        "$value": "#885ee7"
