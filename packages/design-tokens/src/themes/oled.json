{
  "$description": "OLED (from Mudrix)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "oled",
      "name": "OLED",
      "scheme": "dark",
      "order": 2
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#000000",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#050505",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#121212",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#030303"
      },
      "hover": {
        "$value": "#ffffff0f"
      },
      "active": {
        "$value": "#6d7cff33"
      },
      "overlay": {
        "$value": "#000000a6",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#e6e6e6"
      },
      "secondary": {
        "$value": "#b8b8b8"
      },
      "muted": {
        "$value": "#8a8a8a"
      },
      "disabled": {
        "$value": "#5a5a5a"
      },
      "onAccent": {
        "$value": "#ffffff"
      },
      "link": {
        "$value": "#4ea8ff"
      }
