{
  "$description": "Hallow (from the original WizardChat themes)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "hallow",
      "name": "Hallow",
      "scheme": "dark",
      "order": 14
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#170f07",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#22160c",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#2e1e11",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#1f140a"
      },
      "hover": {
        "$value": "rgba(255, 123, 0, 0.08)"
      },
      "active": {
        "$value": "rgba(255, 123, 0, 0.18)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#f2e6da"
      },
      "secondary": {
        "$value": "#7d6455"
      },
      "muted": {
        "$value": "#a88a72"
      },
      "disabled": {
        "$value": "#7d6455"
      },
      "onAccent": {
        "$value": "#ffffff"
      },
      "link": {
        "$value": "#4EA8FF"
      }
    },
    "accent": {
      "default": {
        "$value": "#ff7b00"
      },
      "hover": {
        "$value": "#ff9d00"
      },
      "soft": {
        "$value": "rgba(255, 123, 0, 0.18)",
        "$description": "Tinted backgrounds, selected rows"
      },
      "glow1": {
        "$value": "rgba(255, 123, 0, 0.08)",
        "$description": "Background glow behind the app"
      },
      "glow2": {
        "$value": "rgba(255, 123, 0, 0.05)"
      }
    },
    "border": {
      "default": {
        "$value": "#3a2818"
      },
      "strong": {
        "$value": "#3a2818"
      },
      "focus": {
        "$value": "#ff7b00"
      }
    },
    "status": {
      "danger": {
        "$value": "#c0392b"
      },
      "error": {
        "$value": "#ff6b6b"
      },
      "success": {
        "$value": "#3ba55d"
      },
      "warning": {
        "$value": "#ff9d00"
      },
      "info": {
        "$value": "#4EA8FF"
      },
      "mention": {
        "$value": "#f06428"
      }
    },
    "presence": {
      "online": {
        "$value": "#4ade80"
      },
      "away": {
        "$value": "#facc15"
      },
      "busy": {
        "$value": "#ef4444"
      },
      "offline": {
        "$value": "#6b7280"
      }
    },
    "role": {
      "founder": {
        "$value": "#a855f7"
      },
      "admin": {
        "$value": "#ef4444"
      },
      "moderator": {
        "$value": "#eab308"
      },
      "member": {
        "$value": "#3b82f6"
      }
    },
    "logo": {
      "p0": {
        "$value": "#111111"
      },
      "p1": {
        "$value": "#2B1F3A"
      },
      "p2": {
        "$value": "#4A2A78"
      },
      "p3": {
        "$value": "#7A4BC0"
      },
      "p4": {
        "$value": "#E65F00"
      },
      "p5": {
        "$value": "#FF9D00"
      },
      "hover": {
        "$value": "#FFB84D"
      },
      "hoverGlow": {
        "$value": "#FFB84D99"
      }
    },
    "message": {
      "mine": {
        "$value": "#8f4000"
      },
      "other": {
        "$value": "#2e1e11"
      },
      "highlight": {
        "$value": "#f0642826",
        "$description": "Messages that mention you"
      }
    },
    "username": {
      "c1": {
        "$value": "#4ea8ff"
      },
      "c2": {
        "$value": "#d66bd1"
      },
      "c3": {
        "$value": "#2bd4a0"
      },
      "c4": {
        "$value": "#ff6b92"
      },
      "c5": {
        "$value": "#ff9a4d"
      },
      "c6": {
        "$value": "#3fd3d6"
      },
      "c7": {
        "$value": "#8c87ff"
      },
      "c8": {
        "$value": "#8fdb4a"
      }
    }
  }
}
