{
  "$description": "Blossom (from the original WizardChat themes)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "blossom",
      "name": "Blossom",
      "scheme": "light",
      "order": 29
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#ffffff",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#fff1f5",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#fde2ea",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#ffffff"
      },
      "hover": {
        "$value": "rgba(214, 69, 122, 0.07)"
      },
      "active": {
        "$value": "rgba(214, 69, 122, 0.14)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#2d1a22"
      },
      "secondary": {
        "$value": "#b08a98"
      },
      "muted": {
        "$value": "#8a6573"
      },
      "disabled": {
        "$value": "#b08a98"
      },
      "onAccent": {
        "$value": "#ffffff"
      },
      "link": {
        "$value": "#1F6FD1"
      }
    },
    "accent": {
      "default": {
        "$value": "#d6457a"
      },
      "hover": {
        "$value": "#bd3568"
      },
      "soft": {
        "$value": "rgba(214, 69, 122, 0.14)",
        "$description": "Tinted backgrounds, selected rows"
      },
      "glow1": {
        "$value": "rgba(214, 69, 122, 0.08)",
        "$description": "Background glow behind the app"
      },
      "glow2": {
        "$value": "rgba(214, 69, 122, 0.04)"
      }
    },
    "border": {
      "default": {
        "$value": "#f6d5df"
      },
      "strong": {
        "$value": "#f6d5df"
      },
      "focus": {
        "$value": "#d6457a"
      }
    },
    "status": {
      "danger": {
        "$value": "#b91c1c"
      },
      "error": {
        "$value": "#dc2626"
      },
      "success": {
        "$value": "#16a34a"
      },
      "warning": {
        "$value": "#d97706"
      },
      "info": {
        "$value": "#1F6FD1"
      },
      "mention": {
        "$value": "#f06428"
      }
    },
    "presence": {
      "online": {
        "$value": "#22c55e"
      },
      "away": {
        "$value": "#eab308"
      },
      "busy": {
        "$value": "#dc2626"
      },
      "offline": {
        "$value": "#9ca3af"
      }
    },
    "logo": {
      "p0": {
        "$value": "#7F1F42"
      },
      "p1": {
        "$value": "#9C2A52"
      },
      "p2": {
        "$value": "#B8325F"
      },
      "p3": {
        "$value": "#D6457A"
      },
      "p4": {
        "$value": "#E05B8C"
      },
      "p5": {
        "$value": "#E9729C"
