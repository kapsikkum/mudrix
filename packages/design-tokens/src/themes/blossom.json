      "c2": {
        "$value": "#a3329f"
      },
      "c3": {
        "$value": "#0a8f68"
      },
      "c4": {
        "$value": "#d23f69"
      },
      "c5": {
        "$value": "#c75a12"
      },
      "c6": {
        "$value": "#14898c"
      },
      "c7": {
        "$value": "#4f49e0"
      },
      "c8": {
        "$value": "#4a8f12"
      }
    }
  }
