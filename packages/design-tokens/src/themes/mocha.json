{
  "$description": "Mocha (from Mudrix)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "mocha",
      "name": "Mocha",
      "scheme": "dark",
      "order": 22
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#1e1e2e",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#181825",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#313244",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#101018"
      },
      "hover": {
        "$value": "rgba(255, 255, 255, 0.06)"
      },
      "active": {
        "$value": "rgba(203, 166, 247, 0.2)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#cdd6f4"
      },
      "secondary": {
        "$value": "#767b92"
      },
      "muted": {
        "$value": "#a6adc8"
