      "glow1": {
        "$value": "rgba(203, 166, 247, 0.05)",
        "$description": "Background glow behind the app"
      },
      "glow2": {
        "$value": "rgba(203, 166, 247, 0.03)"
      }
    },
    "border": {
      "default": {
        "$value": "#313244"
      },
      "strong": {
        "$value": "#313244"
      },
      "focus": {
        "$value": "#cba6f7"
      }
