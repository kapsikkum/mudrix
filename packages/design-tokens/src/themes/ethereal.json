{
  "$description": "Ethereal (from the original WizardChat themes)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "ethereal",
      "name": "Ethereal",
      "scheme": "light",
      "order": 23
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#ffffff",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#f2f3f5",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#e3e5e8",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#ebedef"
      },
      "hover": {
        "$value": "rgba(6, 6, 7, 0.05)"
      },
      "active": {
        "$value": "rgba(88, 101, 242, 0.14)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#313338"
      },
      "secondary": {
        "$value": "#747780"
      },
