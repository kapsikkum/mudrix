{
  "$description": "Parrot (from the original WizardChat themes)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "parrot",
      "name": "Parrot",
      "scheme": "dark",
      "order": 12
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#0d1117",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#161b22",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#21262d",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#0d1117"
      },
      "hover": {
        "$value": "rgba(63, 185, 80, 0.08)"
      },
      "active": {
        "$value": "rgba(63, 185, 80, 0.18)"
      },
      "overlay": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#e6edf3"
      },
      "secondary": {
        "$value": "#6e7681"
      },
      "muted": {
        "$value": "#8b949e"
      },
      "disabled": {
        "$value": "#6e7681"
      },
      "onAccent": {
        "$value": "#ffffff"
      },
      "link": {
        "$value": "#4EA8FF"
      }
    },
    "accent": {
      "default": {
        "$value": "#3fb950"
      },
      "hover": {
        "$value": "#56d364"
      },
      "soft": {
        "$value": "rgba(63, 185, 80, 0.18)",
        "$description": "Tinted backgrounds, selected rows"
      },
      "glow1": {
        "$value": "rgba(63, 185, 80, 0.08)",
        "$description": "Background glow behind the app"
      },
      "glow2": {
        "$value": "rgba(63, 185, 80, 0.05)"
      }
    },
    "border": {
      "default": {
        "$value": "#30363d"
      },
      "strong": {
        "$value": "#30363d"
      },
      "focus": {
        "$value": "#3fb950"
      }
    },
    "status": {
      "danger": {
        "$value": "#f85149"
      },
      "error": {
        "$value": "#f85149"
      },
      "success": {
        "$value": "#3fb950"
      },
      "warning": {
        "$value": "#e3a008"
      },
      "info": {
        "$value": "#4EA8FF"
      },
      "mention": {
        "$value": "#f06428"
      }
    },
    "presence": {
      "online": {
        "$value": "#4ade80"
      },
      "away": {
        "$value": "#facc15"
      },
      "busy": {
        "$value": "#ef4444"
      },
      "offline": {
        "$value": "#6b7280"
      }
    },
    "logo": {
      "p0": {
        "$value": "#1E5128"
      },
      "p1": {
        "$value": "#34743E"
      },
      "p2": {
        "$value": "#A8201A"
      },
      "p3": {
        "$value": "#D7412F"
      },
      "p4": {
        "$value": "#E0A526"
      },
      "p5": {
        "$value": "#F5D547"
      },
      "hover": {
        "$value": "#79C183"
      },
      "hoverGlow": {
        "$value": "#79C18399"
      }
    },
    "message": {
      "mine": {
        "$value": "#0f2d1a"
      },
      "other": {
        "$value": "#1c2128"
      },
      "highlight": {
        "$value": "#f0642826",
        "$description": "Messages that mention you"
      }
    },
    "username": {
      "c1": {
        "$value": "#4ea8ff"
      },
      "c2": {
        "$value": "#d66bd1"
      },
      "c3": {
        "$value": "#2bd4a0"
      },
      "c4": {
        "$value": "#ff6b92"
      },
      "c5": {
        "$value": "#ff9a4d"
      },
      "c6": {
        "$value": "#3fd3d6"
      },
      "c7": {
        "$value": "#8c87ff"
      },
      "c8": {
        "$value": "#8fdb4a"
      }
    }
  }
}
