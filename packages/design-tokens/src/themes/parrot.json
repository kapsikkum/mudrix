{
  "$description": "Parrot (from the original WizardChat themes)",
  "$extensions": {
    "org.wizardchat.theme": {
      "id": "parrot",
      "name": "Parrot",
      "scheme": "dark"
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "app": {
        "$value": "#0d1117",
        "$description": "Chat and main background"
      },
      "surface": {
        "$value": "#161b22",
        "$description": "Room list, space rail, panels"
      },
      "raised": {
        "$value": "#21262d",
        "$description": "Cards, menus, popovers"
      },
      "input": {
        "$value": "#0d1117"
      },
      "hover": {
        "$value": "#3fb95014"
      },
      "active": {
        "$value": "#3fb9502e"
      },
      "overlay": {
        "$value": "#000000a6",
        "$description": "Dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "#e6edf3"
      },
      "secondary": {
        "$value": "#b8c0c8"
      },
      "muted": {
        "$value": "#8b949e"
