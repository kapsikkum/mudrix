# Copy to apps/web/.env.local (git-ignored). Vite embeds VITE_* values into the client bundle at build
# time, so these keys are visible to anyone who can load the app. Leave a key empty to disable
# that provider's tab in the GIF picker. See docs/SECRETS.md.
VITE_GIPHY_API_KEY=
VITE_KLIPY_API_KEY=
