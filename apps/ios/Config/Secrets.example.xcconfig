// Copy to Secrets.xcconfig (not committed) to build with GIF search. Without it the GIF picker shows
// "No API key configured in this build". CI can pass GIPHY_API_KEY to xcodebuild as a build setting instead.
// Keep the value free of "//" and quotes; xcconfig treats "//" as a comment.
GIPHY_API_KEY =
// How notifications arrive while the app is closed: keepalive (default, no server) or apns.
// apns also needs the Push Notifications capability (set WZ_ENTITLEMENTS to WizardChat/WizardChat-Push.entitlements
// in Local.xcconfig) and a Matrix push gateway notify URL. Keep the URL free of "//" by writing it as https:/$()/host/...
WZ_PUSH_MODE = keepalive
WZ_PUSH_GATEWAY_URL =
