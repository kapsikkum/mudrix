        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WizardChat uses your camera for video calls and to scan QR codes when you sign in."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WizardChat nutzt deinen Standort nur, wenn du ihn in einem Chat teilst."
