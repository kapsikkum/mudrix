    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WizardChat nutzt deine Kamera für Videoanrufe und zum Scannen von QR-Codes bei der Anmeldung."
