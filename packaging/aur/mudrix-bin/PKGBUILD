# CI fills in _version, pkgver and sha256sums and publishes this with every release (docs/BUILDING.md)
pkgname=mudrix-bin
_version=0.0.0
pkgver=0.0.0
pkgrel=1
pkgdesc='Simple, secure, magical Matrix client'
arch=('x86_64')
url='https://github.com/kapsikkum/mudrix'
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'gst-plugins-base' 'gst-plugins-good')
optdepends=('gst-plugins-bad: voice and video calls' 'gst-libav: more video formats')
provides=('mudrix')
conflicts=('mudrix')
options=('!debug')
source=("https://github.com/kapsikkum/mudrix/releases/download/v${_version}/mudrix-${_version}-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cp -a "${srcdir}/usr" "${pkgdir}/"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
