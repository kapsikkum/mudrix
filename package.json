{
  "name": "wizardchat",
  "version": "26.10.3",
  "type": "module",
  "description": "Simple, Secure, Magical",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/wizardchat/wizardchat-web"
  },
  "author": "Arian Farahani, Jan Philipp Kleinschmidt",
  "license": "AGPL-3.0",
  "homepage": "https://wizardchat.org",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@element-hq/element-call-embedded": "^0.23.0",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource/roboto": "^5.2.10",
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-virtual": "^3.14.5",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "dompurify": "^3.4.1",
    "emojibase-data": "^17.0.0",
    "focus-trap-react": "^12.0.3",
    "i18next": "^26.0.0",
    "jotai": "^2.19.1",
    "marked": "^18.0.2",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "^41.8.0",
    "matrix-widget-api": "^1.17.0",
    "opus-recorder": "^8.0.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "react-router-dom": "^6.30.3",
    "slate": "^0.126.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.126.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.1.2",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ]
  }
}
